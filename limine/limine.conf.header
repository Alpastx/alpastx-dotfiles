### Read more at config document: https://github.com/limine-bootloader/limine/blob/trunk/CONFIG.md
#timeout: 3
default_entry: 2
interface_branding: HackBench
interface_branding_color: 89b4fa
interface_help_color: 89b4fa
interface_help_color_bright: 89b4fa
hash_mismatch_panic: no

term_background: 000000
backdrop: 000000

# Terminal colors (Bluegirl / Catppuccin Mocha, AMOLED black)
term_palette: 000000;f38ba8;a6e3a1;f9e2af;89b4fa;cba6f7;94e2d5;cdd6f4
term_palette_bright: 45475a;f38ba8;a6e3a1;f9e2af;89b4fa;cba6f7;94e2d5;ffffff

# Text colors
term_foreground: cdd6f4
term_foreground_bright: ffffff
term_background_bright: 1a1a1a
